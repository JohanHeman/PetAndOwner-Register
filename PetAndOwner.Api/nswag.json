{
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "url": "http://localhost:5253/openapi/v1.json"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "ApiClient",
      "template": "Angular",
      "httpClass": "HttpClient",
      "generateClientClasses": true,
      "generateClientInterfaces": false,
      "generateDtoTypes": true,
      "generateOptionalParameters": true,
      "typeStyle": "Interface",
      "dateTimeType": "Date",
      "injectionTokenType": "InjectionToken",
      "output": "../PetAndOwner.Presentation/src/app/api/api-client.ts"
    }
  }
}
